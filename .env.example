# ─────────────────────────────────────────────────────────────
# FeedLoop Decode — environment
# Copy to .env.local and fill in. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ──
# Every decode run makes real, billed model calls through OpenRouter.
# Without this the pipeline throws "OPENROUTER_API_KEY is not set" at the
# embedding step and the UI shows "Analysis failed. Please try again."
# Get one at https://openrouter.ai/keys
#
# Models used (all via OpenRouter, see src/lib/llm.ts + src/lib/embeddings.ts):
#   openai/gpt-5.4-nano            — classify, cluster (x2), summarize
#   openai/text-embedding-3-small  — embeddings, 1024 dims, ONE call per item
#
# Roughly 40 API calls for a 30-item run: 1 classify + 30 embed + 2 cluster
# + ~7 summarize. Budget accordingly when testing.
OPENROUTER_API_KEY=

# ── OPTIONAL ──

# Upstash Redis. Backs BOTH the rate limiter (src/lib/rateLimit.ts) and the
# funnel events (src/lib/events.ts). Omit locally — both fall back to
# in-memory, which is fine for dev but does not survive a restart.
# Required in production: without it, funnel data is lost on every cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects GET /api/analytics behind the X-Analytics-Key header.
# If unset, the endpoint returns 401 to everyone — including you.
# Set it to read the funnel:
#   curl -H "X-Analytics-Key: $ANALYTICS_SECRET" localhost:3000/api/analytics?summary=true
ANALYTICS_SECRET=

# Base URL used to build shareable /r/[id] links and OG tags.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_URL=http://localhost:3000
